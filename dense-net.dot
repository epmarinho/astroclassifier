digraph G {
    rankdir=LR; // Sets the direction of the graph from left to right
    node [shape=circle]; // Sets the default node shape to circle

    // Define input layer nodes
    subgraph cluster_0 {
        label="Input Layer";
        color=transparent;
        x0 [label="x0"];
        x1 [label="x1"];
        x2 [label="x2"];
        x3 [label="x3"];
        x4 [label="x4"];
        x5 [label="x5"];
        x6 [label="x6"];
        x7 [label="x7"];
    }

    // Define hidden layer nodes
    subgraph cluster_1 {
        label="Hidden Layer";
        color=transparent;
        // Assuming hidden layer has 4 neurons for demonstration
        h0; h1; h2; h3;
    }

    // Define output layer nodes
    subgraph cluster_2 {
        label="Output Layer";
        color=transparent;
        y0 [label="y0"];
        y1 [label="y1"];
    }

    // Create edges from input to hidden layer
    x0 -> {h0; h1; h2; h3};
    x1 -> {h0; h1; h2; h3};
    x2 -> {h0; h1; h2; h3};
    x3 -> {h0; h1; h2; h3};
    x4 -> {h0; h1; h2; h3};
    x5 -> {h0; h1; h2; h3};
    x6 -> {h0; h1; h2; h3};
    x7 -> {h0; h1; h2; h3};

    // Create edges from hidden to output layer
    {h0; h1; h2; h3} -> y0;
    {h0; h1; h2; h3} -> y1;
}

// compile with
// dot -Tpng dense-net.dot -o dense-net.png
