digraph G {
    rankdir=LR; // Sets the direction of the graph from left to right
    node [shape=circle]; // Sets the default node shape to circle

    // Define input layer nodes
    subgraph cluster_0 {
        label="Input Layer";
        color=transparent;
        x0 [label="x0"];
        x1 [label="x1"];
        x2 [label="x2"];
        x3 [label="x3"];
    }

    // Define hidden layer nodes
    subgraph cluster_1 {
        label="Hidden Layer";
        color=transparent;
        // Assuming hidden layer has 4 neurons for demonstration
        h0; h1;
    }

    // Define output layer nodes
    subgraph cluster_2 {
        label="Output Layer";
        color=transparent;
        y0 [label="y0"];
    }

    // Create edges from input to hidden layer
    x0 -> {h0; h1};
    x1 -> {h0; h1};
    x2 -> {h0; h1};
    x3 -> {h0; h1};
    // Create edges from hidden to output layer
    {h0; h1} -> y0;
}

// compile with
// dot -Tpng perceptron.dot -o perceptron.png
